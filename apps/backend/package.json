{
  "name": "finance-backend",
  "version": "2.0.0",
  "description": "Modular Hono.js Finance API with Drizzle ORM",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "bun run --watch server.ts",
    "start": "bun run server.ts",
    "build": "bun build server.ts --outdir=dist --target=bun",
    "type-check": "tsc --noEmit",
    "migrate:users": "bun run scripts/migrate-users.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.0",
    "@hono/zod-validator": "^0.2.0",
    "@libsql/client": "^0.15.14",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.29.0",
    "hono": "^4.9.6",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.4",
    "pg": "^8.16.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "bun-types": "^1.0.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "hono",
    "finance",
    "api",
    "drizzle",
    "typescript",
    "modular"
  ]
}
