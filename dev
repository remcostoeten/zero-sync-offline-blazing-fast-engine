#!/usr/bin/env bash

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Process IDs
BACKEND_PID=""
FRONTEND_PID=""
INPUT_HANDLER_PID=""

# Cleanup function
cleanup() {
    echo -e "\n${YELLOW}🛑 Shutting down services...${NC}"
    
    # Stop input handler first
    if [ ! -z "$INPUT_HANDLER_PID" ] && kill -0 "$INPUT_HANDLER_PID" 2>/dev/null; then
        kill -TERM "$INPUT_HANDLER_PID" 2>/dev/null
        wait "$INPUT_HANDLER_PID" 2>/dev/null
    fi
    
    if [ ! -z "$BACKEND_PID" ] && kill -0 "$BACKEND_PID" 2>/dev/null; then
        echo -e "${YELLOW}📡 Stopping backend server (PID: $BACKEND_PID)...${NC}"
        kill -TERM "$BACKEND_PID" 2>/dev/null
        wait "$BACKEND_PID" 2>/dev/null
    fi
    
    if [ ! -z "$FRONTEND_PID" ] && kill -0 "$FRONTEND_PID" 2>/dev/null; then
        echo -e "${BLUE}🌐 Stopping frontend server (PID: $FRONTEND_PID)...${NC}"
        kill -TERM "$FRONTEND_PID" 2>/dev/null
        wait "$FRONTEND_PID" 2>/dev/null
    fi
    
    echo -e "${GREEN}✅ All services stopped successfully${NC}"
    exit 0
}

# Port check function
check_port() {
    local port=$1
    local service=$2
    
    if lsof -Pi :$port -sTCP:LISTEN -t >/dev/null 2>&1; then
        echo -e "${RED}❌ Error: Port $port is already in use by another process${NC}"
        echo -e "${YELLOW}💡 Please stop the process using port $port or use a different port${NC}"
        echo -e "${CYAN}To check what's using the port: ${NC}lsof -i :$port"
        exit 1
    fi
}

# Trap signals for cleanup
trap cleanup SIGINT SIGTERM

# Check if required commands exist
if ! command -v bun &> /dev/null; then
    echo -e "${RED}❌ Error: bun is not installed or not in PATH${NC}"
    echo -e "${YELLOW}💡 Please install bun first: https://bun.sh/docs/installation${NC}"
    exit 1
fi

# Check if we're in the right directory
if [ ! -f "package.json" ] || [ ! -d "apps" ]; then
    echo -e "${RED}❌ Error: Please run this script from the project root directory${NC}"
    exit 1
fi

# Check if backend and frontend directories exist
if [ ! -d "apps/backend" ] || [ ! -d "apps/frontend" ]; then
    echo -e "${RED}❌ Error: Backend or frontend directory not found${NC}"
    exit 1
fi

# Check if ports are available
check_port 4000 "backend"
check_port 41000 "frontend"

# Display startup banner
echo -e "${MAGENTA}╔════════════════════════════════════════════════════════╗${NC}"
echo -e "${MAGENTA}║                   🚀 Starting Dev Servers              ║${NC}"
echo -e "${MAGENTA}╚════════════════════════════════════════════════════════╝${NC}"
echo -e ""
echo -e "${CYAN}📡 Backend Server:  ${NC}http://localhost:4000"
echo -e "${BLUE}🌐 Frontend Server: ${NC}http://localhost:41000"
echo -e ""
echo -e "${YELLOW}Press Ctrl+C to stop both servers${NC}"
echo -e "─────────────────────────────────────────────────────────"

# Function to start backend
start_backend() {
    echo -e "${CYAN}[BACKEND]${NC} Starting Hono server on port 4000..."
    cd apps/backend
    bun run --watch server.ts &
    BACKEND_PID=$!
    cd ../..
    
    # Wait a moment for the server to start
    sleep 2
    
    if kill -0 "$BACKEND_PID" 2>/dev/null; then
        echo -e "${CYAN}[BACKEND]${NC} ✅ Server started successfully (PID: $BACKEND_PID)"
    else
        echo -e "${CYAN}[BACKEND]${NC} ❌ Failed to start server"
        exit 1
    fi
}

# Function to start frontend
start_frontend() {
    echo -e "${BLUE}[FRONTEND]${NC} Starting Next.js server on port 41000..."
    cd apps/frontend
    bun dev --turbopack --port 41000 &
    FRONTEND_PID=$!
    cd ../..
    
    # Wait a moment for the server to start
    sleep 3
    
    if kill -0 "$FRONTEND_PID" 2>/dev/null; then
        echo -e "${BLUE}[FRONTEND]${NC} ✅ Server started successfully (PID: $FRONTEND_PID)"
    else
        echo -e "${BLUE}[FRONTEND]${NC} ❌ Failed to start server"
        cleanup
        exit 1
    fi
}

# Start both servers
start_backend
start_frontend

echo -e ""
echo -e "${GREEN}🎉 Both servers are now running!${NC}"
echo -e ""
echo -e "${CYAN}📋 Quick Links:${NC}"
echo -e "   Backend API:     http://localhost:4000"
echo -e "   Backend Health:  http://localhost:4000/health"
echo -e "   Finance API:     http://localhost:4000/api/finance"
echo -e "   Frontend App:    http://localhost:41000"
echo -e ""
echo -e "${YELLOW}💡 Interactive Controls:${NC}"
echo -e "   Press ${CYAN}1${NC} to open Backend API in browser"
echo -e "   Press ${BLUE}2${NC} to open Frontend App in browser"
echo -e "   Press ${MAGENTA}3${NC} to open Backend in Cursor IDE"
echo -e "   Press ${CYAN}4${NC} to open Frontend in Cursor IDE"
echo -e "   Press ${YELLOW}h${NC} for help"
echo -e "   Press ${MAGENTA}Ctrl+C${NC} to stop all servers"
echo -e ""
echo -e "${CYAN}📝 Logs will appear below:${NC}"
echo -e "─────────────────────────────────────────────────────────"

# Function to open URL in browser
open_url() {
    local url=$1
    local name=$2
    
    echo -e "${CYAN}🌐 Opening $name in browser...${NC}"
    
    # Try different browser commands based on the system
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    elif command -v gnome-open >/dev/null 2>&1; then
        gnome-open "$url" >/dev/null 2>&1 &
    elif command -v open >/dev/null 2>&1; then
        open "$url" >/dev/null 2>&1 &
    else
        echo -e "${YELLOW}⚠️  Could not detect browser command. Please open manually: $url${NC}"
        return 1
    fi
    
    sleep 1
    echo -e "${GREEN}✅ $name opened successfully${NC}"
}

# Function to open project in Cursor IDE
open_cursor() {
    local path=$1
    local name=$2
    
    echo -e "${MAGENTA}💻 Opening $name in Cursor...${NC}"
    
    # Try different cursor commands
    if command -v cursor >/dev/null 2>&1; then
        cursor "$path" >/dev/null 2>&1 &
    elif command -v code >/dev/null 2>&1; then
        # Fallback to VS Code if Cursor not found
        echo -e "${YELLOW}📝 Cursor not found, opening with VS Code instead...${NC}"
        code "$path" >/dev/null 2>&1 &
    else
        echo -e "${YELLOW}⚠️  Neither Cursor nor VS Code found. Please install Cursor IDE${NC}"
        echo -e "${CYAN}💡 Install Cursor: https://cursor.sh/${NC}"
        return 1
    fi
    
    sleep 1
    echo -e "${GREEN}✅ $name opened successfully in IDE${NC}"
}

# Simple keyboard input handler that works alongside server output
input_handler() {
    exec 3< /dev/tty  # Open TTY for reading
    
    while true; do
        # Use timeout with read to avoid blocking
        if read -t 1 -n 1 -u 3 key 2>/dev/null; then
            case $key in
                '1')
                    echo >&2  # New line
                    echo -e "${YELLOW}[✨ ACTION]${NC} Opening Backend API in browser..." >&2
                    open_url "http://localhost:4000" "Backend API" >&2
                    ;;
                '2')
                    echo >&2
                    echo -e "${YELLOW}[✨ ACTION]${NC} Opening Frontend App in browser..." >&2
                    open_url "http://localhost:41000" "Frontend App" >&2
                    ;;
                '3')
                    echo >&2
                    echo -e "${YELLOW}[✨ ACTION]${NC} Opening Backend in Cursor IDE..." >&2
                    open_cursor "$(pwd)/apps/backend" "Backend Project" >&2
                    ;;
                '4')
                    echo >&2
                    echo -e "${YELLOW}[✨ ACTION]${NC} Opening Frontend in Cursor IDE..." >&2
                    open_cursor "$(pwd)/apps/frontend" "Frontend Project" >&2
                    ;;
                'h'|'H')
                    echo >&2
                    echo -e "${CYAN}[📚 HELP]${NC} Available keyboard shortcuts:" >&2
                    echo -e "  ${CYAN}1${NC} → Open Backend API in browser" >&2
                    echo -e "  ${BLUE}2${NC} → Open Frontend App in browser" >&2
                    echo -e "  ${MAGENTA}3${NC} → Open Backend project in Cursor IDE" >&2
                    echo -e "  ${CYAN}4${NC} → Open Frontend project in Cursor IDE" >&2
                    echo -e "  ${YELLOW}h${NC} → Show this help message" >&2
                    echo -e "  ${MAGENTA}Ctrl+C${NC} → Stop all servers" >&2
                    ;;
            esac
        fi
        
        # Check if both processes are still running
        if ! kill -0 "$BACKEND_PID" 2>/dev/null || ! kill -0 "$FRONTEND_PID" 2>/dev/null; then
            exec 3<&-  # Close TTY
            break
        fi
    done
    
    exec 3<&-  # Close TTY
}

# Start input handler in background
input_handler &
INPUT_HANDLER_PID=$!

# Wait for the server processes to complete
wait
